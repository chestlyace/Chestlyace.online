# Copy to .env.local and fill in. Never commit real values.
# Reference: docs/architecture.md §8

# main site — Neon pooled connection string (set by the Vercel–Neon integration)
DATABASE_URL=

# admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# admin uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# creatives site — CMS variables are added once the CMS is chosen (Q1)

# /api/revalidate, shared with the CMS webhook
REVALIDATE_SECRET=

# cross-site links (override lib/sites.ts per environment)
NEXT_PUBLIC_MAIN_URL=
NEXT_PUBLIC_CREATIVES_URL=
NEXT_PUBLIC_BLOG_URL=
