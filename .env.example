# Copy to .env.local and fill in. Never commit real values.
# Reference: docs/architecture.md §8

# main site — Prisma Postgres connection string (set by the Vercel–Prisma
# integration; locally: `vercel env pull .env.local` or copy from the Prisma console)
DATABASE_URL=
# optional — direct (unpooled) connection for `pnpm db:migrate`; falls back to DATABASE_URL
DIRECT_URL=

# admin (admin.chestlyace.online): `pnpm admin:hash` prints the hash. In a .env file
# every `$` in it must be written `\$` (Next expands `$name`); Vercel takes it as is.
ADMIN_PASSWORD_HASH=
# at least 32 random characters; changing it signs everyone out
SESSION_SECRET=

# admin uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# creatives site — CMS variables are added once the CMS is chosen (Q1)

# /api/revalidate, shared with the CMS webhook
REVALIDATE_SECRET=

# contact form (docs/README.md D69): Resend API key, then the optional
# recipient (defaults to profile.email) and sender (defaults to Resend's sandbox)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# blog: "Publish to DEV" in the admin (docs/blog-markdown.md §4). Create the key in
# DEV Settings → Extensions. Reading your DEV articles for an import needs no key.
DEVTO_API_KEY=

# blog readers: sign-in to comment (docs/phases.md, Phase 9b.5). BETTER_AUTH_SECRET is a
# long random string (openssl rand -base64 32). A provider with no keys is not offered.
# GitHub: an OAuth app whose callback is https://blog.chestlyace.online/api/reader/callback/github
# Google: an OAuth client whose redirect is https://blog.chestlyace.online/api/reader/callback/google
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# the most words in a comment (default 120)
COMMENT_MAX_WORDS=

# SEO: nothing is indexable until this names the sites to open: "main", "main,blog",
# or "on" for all (set it in Vercel at launch; a redeploy applies it). Vercel
# previews are never indexable.
SITE_INDEXING=

# cross-site links (override lib/sites.ts per environment)
NEXT_PUBLIC_MAIN_URL=
NEXT_PUBLIC_CREATIVES_URL=
NEXT_PUBLIC_BLOG_URL=
NEXT_PUBLIC_ADMIN_URL=

# blog newsletter (docs/phases.md, Phase 9b.7): the subscribers are a Resend segment
# (what Resend used to call an audience): put its id in RESEND_AUDIENCE_ID.
# NEWSLETTER_SECRET signs the confirmation links (openssl rand -base64 32). The
# confirmation email is sent with RESEND_API_KEY from CONTACT_FROM_EMAIL.
RESEND_AUDIENCE_ID=
NEWSLETTER_SECRET=
