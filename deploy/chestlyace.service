# /etc/systemd/system/chestlyace.service (docs/hosting.md §3).
# Runs the release that /srv/chestlyace/current points at, on port 3000.
#
# No `-H 127.0.0.1`: next start sends the proxy's rewrites to `localhost`, which
# can resolve to ::1 only, so a server bound to 127.0.0.1 fails every page
# ("Failed to proxy … socket hang up"). Port 3000 stays private because neither
# the EC2 security group nor the server's ufw firewall opens it (docs/hosting.md
# §2–§3); only Caddy, on the same machine, reaches it.
[Unit]
Description=chestlyace.me (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/chestlyace/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
